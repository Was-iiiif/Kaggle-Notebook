ols]\n    ],\n    axis=0\n).reset_index(drop=True)\n\n# Domain labels\ny_adv = np.concatenate([\n    np.zeros(len(X)),\n    np.ones(len(X_test))\n])\n\n# Replace inf with NaN\nX_adv = X_adv.replace(\n    [np.inf, -np.inf],\n    np.nan\n)\n\n# Split\nX_adv_train, X_adv_val, y_adv_train, y_adv_val = train_test_split(\n    X_adv,\n    y_adv,\n    test_size=0.25,\n    random_state=42,\n    stratify=y_adv\n)\n\nadv_model = LGBMClassifier(\n    n_estimators=500,\n    learning_rate=0.03,\n    num_leaves=31,\n    max_depth=6,\n    subsample=0.8,\n    colsample_bytree=0.8,\n    random_state=42,\n    verbosity=-1\n)\n\nadv_model.fit(\n    X_adv_train,\n    y_adv_train\n)\n\nadv_prob = adv_model.predict_proba(\n    X_adv_val\n)[:, 1]\n\nadv_auc = roc_auc_score(\n    y_adv_val,\n    adv_prob\n)\n\nprint(\"===== ADVERSARIAL VALIDATION =====\")\nprint(f\"Train/Test AUC: {adv_auc:.6f}\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-13T09:48:08.115744Z","iopub.execute_input":"2026-08-13T09:48:08.116168Z","iopub.status.idle":"2026-08-13T09:48:20.972911Z","shell.execute_reply.started":"2026-08-13T09:48:08.116082Z","shell.execute_reply":"2026-08-13T09:48:20.972Z"}},"outputs":[{"name":"stdout","text":"===== ADVERSARIAL VALIDATION =====\nTrain/Test AUC: 0.636098\n","output_type":"stream"}],"execution_count":119},{"cell_type":"markdown","source":"# Adversarial Validation — Feature Importance\n\nThe adversarial classifier achieved an AUC of 0.636, indicating meaningful\ndistribution shift between train and test.\n\nWe will now identify which features allow the model to distinguish train\nfrom test.\n\nThese features are candidates for:\n- distribution-shift investigation\n- transformation\n- removal experiments\n\nWe will NOT remove anything yet.","metadata":{}},{"cell_type":"code","source":"print(\"X columns:\", len(X.columns))\nprint(\"X shape:\", X.shape)\n\nprint(\"Adversarial model feature importance:\",\n      len(adv_model.feature_importances_))\n\nprint(\"